APP_ENV=development
AUTH_MODE=demo
DEMO_USER_ID=demo@sentellent.local
CORS_ORIGINS=http://localhost:3000

# Prefer DATABASE_URL locally. ECS may inject the split DB_* values from an RDS-managed secret.
DATABASE_URL=postgresql+asyncpg://sentellent:change-me@localhost:5432/sentellent
# DB_HOST=
# DB_PORT=5432
# DB_NAME=sentellent
# DB_USERNAME=
# DB_PASSWORD=

# Demo fixtures are deterministic. Set live to use yfinance plus the configured RSS feeds.
MARKET_DATA_PROVIDER=demo
RSS_FEEDS=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://www.moneycontrol.com/rss/marketreports.xml,https://www.livemint.com/rss/markets
RSS_REQUEST_TIMEOUT_SECONDS=10
RSS_MIN_REQUEST_INTERVAL_SECONDS=1

# Local deterministic embeddings/generation require no key. OpenAI is optional and falls back locally.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Production Google OIDC. Generate SESSION_SECRET with at least 32 random characters.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
AUTH_SUCCESS_URL=http://localhost:3000
SESSION_SECRET=

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_REQUESTS=30
RATE_LIMIT_MUTATION_REQUESTS=20
RATE_LIMIT_OAUTH_REQUESTS=20
