project_name = "sentellent"
environment  = "production"
aws_region   = "ap-south-1"

# Keep false for the lowest-cost challenge deployment. Set true to place ECS
# tasks in private subnets behind a single NAT gateway.
enable_nat_gateway = false

# CI sets this to the full Git commit SHA.
image_tag = "latest"

# Required: add an ACM certificate in the same region and its canonical origin.
# certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/..."
# public_base_url = "https://stocks.example.com"

database_instance_class     = "db.t4g.micro"
database_backup_retention_days = 1 # Free Tier-compatible; increase when the account allows it.
frontend_desired_count      = 1
backend_desired_count       = 1
service_max_count           = 2
ingestion_schedule_expression = "rate(6 hours)"
oauth_callback_rate_limit      = 100
chat_rate_limit                = 60
mutation_api_rate_limit        = 120

# AWS WAF regex patterns matched against URI paths. Keep these narrow and
# anchored; the stocks pattern intentionally includes descendant paths.
mutation_api_path_patterns = [
  "^/api/v1/chat$",
  "^/api/v1/refresh$",
  "^/api/v1/stocks/.*$",
  "^/api/v1/persona$",
  "^/api/v1/notes$",
  "^/api/v1/conversations$",
]

# Safe production defaults: seven days of backups, deletion protection, and a
# final snapshot named sentellent-production-final on intentional teardown.
database_backup_retention_days = 7
database_deletion_protection   = true

# Server-side admin allowlist. Do not expose this as frontend configuration.
backend_environment = {
  ADMIN_EMAILS = "palaniappan1492@gmail.com"
}

tags = {
  Owner = "your-name"
}
